import socket
client = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server_ip = "192.168.178.131"
server_port = 8000
senden = "test"
client.connect((server_ip, server_port))
client.send(senden.encode("utf-8"))
while True:
    request = client.recv(1024).decode("utf-8")
    print(request)
    senden = input("Gib eine Nachricht ein: ")
    client.send(senden.encode("utf-8"))
    if senden == "exit":
        client.close()
        break
    
